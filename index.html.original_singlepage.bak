<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Lyallpur Store | Authentic Pure Desi Ghee Sweets & Heritage Mithai</title>
  <meta name="description" content="Award-winning editorial heritage e-commerce destination for The Lyallpur Store. Handcrafted since 1975 in Ludhiana with 100% pure cow desi ghee." />
  <meta name="theme-color" content="#180306" />

  <!-- Google Fonts: Didone Serif, Clean Sans, and Handwritten Script -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;0,900;1,600;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            maroon: {
              900: '#180306',
              800: '#27060B',
              700: '#3A0F14',
              600: '#4B161C',
              500: '#6B1F27',
            },
            cream: {
              100: '#F7F1E7',
              200: '#EFE4D0',
              300: '#E3D3B8',
            },
            saffron: {
              500: '#E5A72F',
              600: '#C98F20',
            },
            clay: {
              400: '#B9764F',
            },
          },
          fontFamily: {
            serif: ['"Playfair Display"', '"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'Inter', 'system-ui', 'sans-serif'],
            script: ['"Caveat"', 'cursive', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --maroon-900: #180306;
      --cream-100: #F7F1E7;
      --saffron-500: #E5A72F;
    }

    body {
      background-color: #180306;
      color: #180306;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: clip;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background-color: #E5A72F;
      color: #180306;
    }

    /* Paper Textures */
    .paper-maroon {
      background-color: #180306;
      background-image: 
        radial-gradient(ellipse at 50% 20%, rgba(75, 22, 28, 0.45) 0%, rgba(24, 3, 6, 0.95) 75%),
        url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.045'/%3E%3C/svg%3E");
    }

    .paper-cream {
      background-color: #F7F1E7;
      background-image: 
        linear-gradient(135deg, rgba(255, 255, 255, 0.5) 0%, rgba(239, 228, 208, 0.4) 100%),
        url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
    }

    .paisley-faint {
      background-image: radial-gradient(circle at 10% 20%, rgba(24, 3, 6, 0.03) 0, transparent 40%),
                        radial-gradient(circle at 90% 80%, rgba(24, 3, 6, 0.03) 0, transparent 40%),
                        url("data:image/svg+xml,%3Csvg width='120' height='120' viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M60 15 C75 15, 95 30, 95 55 C95 85, 60 105, 60 105 C60 105, 25 85, 25 55 C25 30, 45 15, 60 15 Z M60 30 C50 30, 40 40, 40 55 C40 70, 60 85, 60 85 C60 85, 80 70, 80 55 C80 40, 70 30, 60 30 Z' fill='%23180306' fill-opacity='0.02'/%3E%3C/svg%3E");
      background-repeat: repeat;
    }

    .paisley-maroon-dark {
      background-image: url("data:image/svg+xml,%3Csvg width='160' height='160' viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M60 15 C75 15, 95 30, 95 55 C95 85, 60 105, 60 105 C60 105, 25 85, 25 55 C25 30, 45 15, 60 15 Z' fill='%23F7F1E7' fill-opacity='0.03'/%3E%3C/svg%3E");
      background-repeat: repeat;
    }

    /* Hard Paper Drop Shadows */
    .shadow-paper {
      box-shadow: 4px 4px 0 rgba(24, 3, 6, 0.85);
    }
    .shadow-paper-sm {
      box-shadow: 2px 2px 0 rgba(24, 3, 6, 0.85);
    }
    .shadow-paper-lg {
      box-shadow: 8px 8px 0 rgba(24, 3, 6, 0.9);
    }

    /* Badge & Sticker Shapes */
    .scalloped-badge {
      clip-path: polygon(
        50% 0%, 57% 5%, 65% 1%, 71% 8%, 79% 6%, 84% 14%, 92% 14%, 95% 23%, 
        100% 26%, 100% 35%, 100% 41%, 97% 50%, 100% 59%, 100% 65%, 100% 74%, 
        95% 77%, 92% 86%, 84% 86%, 79% 94%, 71% 92%, 65% 99%, 57% 95%, 
        50% 100%, 43% 95%, 35% 99%, 29% 92%, 21% 94%, 16% 86%, 8% 86%, 
        5% 77%, 0% 74%, 0% 65%, 0% 59%, 3% 50%, 0% 41%, 0% 35%, 0% 26%, 
        5% 23%, 8% 14%, 16% 14%, 21% 6%, 29% 8%, 35% 1%, 43% 5%
      );
    }

    .starburst-badge {
      clip-path: polygon(
        50% 0%, 63% 13%, 81% 5%, 86% 24%, 100% 27%, 95% 45%, 100% 63%, 86% 69%, 
        85% 88%, 66% 87%, 50% 100%, 35% 87%, 16% 89%, 14% 69%, 0% 63%, 5% 45%, 
        0% 27%, 14% 23%, 17% 5%, 36% 12%
      );
    }

    .ticket-edge {
      border: 1.5px dashed #180306;
    }

    /* Marquee Animation */
    @keyframes marqueeLeft {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(-50%, 0, 0); }
    }
    @keyframes marqueeRight {
      0% { transform: translate3d(-50%, 0, 0); }
      100% { transform: translate3d(0, 0, 0); }
    }

    .animate-marquee-left {
      display: flex;
      width: max-content;
      animation: marqueeLeft 36s linear infinite;
    }
    .animate-marquee-right {
      display: flex;
      width: max-content;
      animation: marqueeRight 40s linear infinite;
    }
    .animate-marquee-left:hover, .animate-marquee-right:hover {
      animation-play-state: paused;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-track { background: #180306; }
    ::-webkit-scrollbar-thumb { background: #E5A72F; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #C98F20; }
  </style>
</head>
<body class="selection:bg-[#E5A72F] selection:text-[#180306]">

  <!-- ================= TOP 3PX SCROLL PROGRESS LINE ================= -->
  <div id="scrollProgress" class="fixed top-0 left-0 h-[3px] bg-[#E5A72F] z-50 transition-all duration-75 shadow-[0_0_8px_#E5A72F] pointer-events-none" style="width: 0%;"></div>

  <!-- ================= GRAND CURTAIN-OPENING LOADING SCREEN ================= -->
  <div id="openingCurtains" class="fixed inset-0 z-50 overflow-hidden pointer-events-auto select-none transition-opacity duration-700">
    <!-- Left Curtain -->
    <div id="leftCurtain" class="absolute top-0 left-0 bottom-0 w-1/2 bg-[#180306] paper-maroon border-r border-[#E5A72F]/20 transition-transform duration-1000 ease-[cubic-bezier(0.76,0,0.24,1)] z-20">
      <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-black/30 pointer-events-none"></div>
    </div>
    <!-- Right Curtain -->
    <div id="rightCurtain" class="absolute top-0 right-0 bottom-0 w-1/2 bg-[#180306] paper-maroon border-l border-[#E5A72F]/20 transition-transform duration-1000 ease-[cubic-bezier(0.76,0,0.24,1)] z-20">
      <div class="absolute inset-0 bg-gradient-to-l from-black/40 via-transparent to-black/30 pointer-events-none"></div>
    </div>
    <!-- Center Stack -->
    <div id="curtainContent" class="absolute inset-0 z-30 flex flex-col items-center justify-center p-6 text-center transition-all duration-500">
      <button onclick="skipIntro()" class="absolute top-6 right-6 text-xs text-[#F7F1E7]/60 hover:text-[#E5A72F] uppercase tracking-widest font-sans transition-colors cursor-pointer py-1 px-3 border border-[#F7F1E7]/20 rounded-full">
        Skip Intro ✕
      </button>
      <div class="flex items-center gap-2 mb-3">
        <i data-lucide="sparkles" class="w-4 h-4 text-[#E5A72F]"></i>
        <span class="font-serif text-[#F7F1E7]/80 text-xs sm:text-sm tracking-[0.25em] uppercase font-semibold">
          THE LYALLPUR STORE
        </span>
        <i data-lucide="sparkles" class="w-4 h-4 text-[#E5A72F]"></i>
      </div>
      <div class="relative my-2">
        <h1 class="font-serif text-6xl sm:text-8xl md:text-9xl font-black text-[#F7F1E7] tracking-tight leading-none drop-shadow-2xl">
          1975
        </h1>
        <div class="absolute -top-4 -right-10 sm:-right-14 w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#E5A72F] text-[#180306] flex items-center justify-center shadow-paper p-1 text-center font-serif text-[8px] sm:text-[9px] font-bold uppercase rotate-12">
          <span>PURE DESI GHEE</span>
        </div>
      </div>
      <p class="font-serif italic text-sm sm:text-base text-[#F7F1E7]/70 mt-3 max-w-md">
        "A sweet story, still being written."
      </p>
      <div id="cyclingWord" class="h-6 mt-6 text-xs sm:text-sm tracking-[0.3em] font-semibold text-[#E5A72F] uppercase">
        ✦ PURE DESI GHEE ✦
      </div>
      <div class="w-56 sm:w-72 mt-8">
        <div class="w-full h-1 bg-[#F7F1E7]/15 rounded-full overflow-hidden">
          <div id="curtainProgress" class="h-full bg-gradient-to-r from-[#E5A72F] to-[#E4702A] rounded-full transition-all duration-75" style="width: 0%;"></div>
        </div>
        <div class="flex justify-between items-center mt-2 text-[10px] sm:text-xs text-[#F7F1E7]/50 font-mono">
          <span>HARVESTING PURITY</span>
          <span id="progressText" class="text-[#E5A72F] font-bold">0%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= TOP ANNOUNCEMENT STRIP ================= -->
  <div class="relative bg-[#180306] border-b border-[#F7F1E7]/10 text-[#F7F1E7] h-[28px] flex items-center justify-center px-4 text-[11px] tracking-wide select-none z-40 overflow-hidden">
    <div class="flex items-center gap-2 font-medium opacity-90 truncate">
      <i data-lucide="sparkles" class="w-3 h-3 text-[#E5A72F] shrink-0"></i>
      <span class="truncate">Handcrafted in Ludhiana with 100% Pure Desi Ghee · Worldwide Express Gifting</span>
      <a href="#online-store-section" class="text-[#E5A72F] underline hover:text-[#F7F1E7] transition-colors ml-1 font-semibold shrink-0">
        Explore Gifting →
      </a>
    </div>
  </div>

  <!-- ================= EDITORIAL STICKY NAVIGATION HEADER ================= -->
  <header id="mainNavbar" class="sticky top-0 left-0 right-0 z-40 transition-all duration-300 bg-transparent py-5 sm:py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <!-- Logo -->
      <a href="#" class="cursor-pointer group flex items-center gap-2 select-none">
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-[#F7F1E7] group-hover:text-[#E5A72F] transition-colors leading-tight">
            The Lyallpur Store
          </span>
          <span class="text-[9px] tracking-[0.3em] font-sans uppercase text-[#E5A72F] font-semibold">
            SINCE 1975 · LUDHIANA
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center space-x-7 select-none">
        <a href="#hero-section" class="text-xs tracking-[0.14em] font-medium text-[#E5A72F] font-bold">HOME</a>
        <a href="#online-store-section" class="text-xs tracking-[0.14em] font-medium text-[#F7F1E7]/80 hover:text-[#F7F1E7] transition-colors">ONLINE STORE</a>
        <a href="#heritage-section" class="text-xs tracking-[0.14em] font-medium text-[#F7F1E7]/80 hover:text-[#F7F1E7] transition-colors">HERITAGE</a>
        <a href="#gallery-section" class="text-xs tracking-[0.14em] font-medium text-[#F7F1E7]/80 hover:text-[#F7F1E7] transition-colors">GALLERY</a>
        <a href="#our-stores-section" class="text-xs tracking-[0.14em] font-medium text-[#F7F1E7]/80 hover:text-[#F7F1E7] transition-colors">OUR STORES</a>
      </nav>

      <!-- Right Group -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        <a href="#online-store-section" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full border border-[#F7F1E7]/50 text-[#F7F1E7] text-xs font-semibold uppercase tracking-wider hover:bg-[#E5A72F] hover:text-[#180306] hover:border-[#E5A72F] transition-all cursor-pointer shadow-sm">
          <span>ORDER SWEETS</span>
          <span class="text-[11px]">→</span>
        </a>

        <button onclick="toggleCart()" aria-label="Cart" class="relative p-2 text-[#F7F1E7] hover:text-[#E5A72F] transition-colors rounded-full hover:bg-white/5 cursor-pointer">
          <i data-lucide="shopping-bag" class="w-5 h-5"></i>
          <span id="navCartBadge" class="absolute top-0.5 right-0.5 w-4 h-4 rounded-full bg-[#E5A72F] text-[#180306] font-sans text-[10px] font-bold flex items-center justify-center shadow-sm">
            0
          </span>
        </button>
      </div>
    </div>
  </header>

  <!-- ================= MAIN SCROLL JOURNEY ================= -->
  <main class="relative z-10">

    <!-- 1. HERO SCROLL TRACK (500VH APPLE-STYLE PINNED CANVAS SEQUENCE) -->
    <section id="hero-track" class="relative w-full bg-[#180306]" style="height: 500vh;">
      <div id="hero-sticky" class="sticky top-0 h-[100svh] w-full bg-[#180306] paper-maroon text-[#F7F1E7] overflow-hidden flex flex-col justify-between pt-4 sm:pt-6 pb-8 sm:pb-12 select-none z-10">
        <!-- Scroll Sequence Background Canvas -->
        <canvas id="heroFrameCanvas" class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none opacity-90"></canvas>
        <div class="absolute inset-0 bg-gradient-to-r from-[#180306]/92 via-[#180306]/65 to-[#180306]/20 pointer-events-none z-1"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_45%_35%,rgba(75,22,28,0.5)_0%,transparent_65%)] pointer-events-none z-1"></div>
        <div id="heroHandoffVeil" class="absolute inset-0 bg-[#180306] pointer-events-none z-2 opacity-0 transition-opacity duration-300"></div>

        <!-- Rotated Edge Micro-Text -->
        <div class="hidden xl:block absolute left-6 top-1/2 -translate-y-1/2 -rotate-90 origin-left text-[10px] tracking-[0.35em] text-[#E5A72F]/60 font-mono uppercase z-20">
          PURE DESI GHEE · PUNJAB · 1975
        </div>
        <div class="hidden xl:block absolute right-6 top-1/2 -translate-y-1/2 rotate-90 origin-right text-[10px] tracking-[0.35em] text-[#E5A72F]/60 font-mono uppercase z-20">
          LUDHIANA HERITAGE CONFECTIONERY
        </div>

        <!-- Upper-Right Rotated Sweet Shop Ticket (Video Match) -->
        <div class="absolute top-6 sm:top-10 right-4 sm:right-12 md:right-20 z-25 transition-transform duration-300 hover:rotate-0 hover:scale-105 pointer-events-none sm:pointer-events-auto">
          <div class="ticket-edge bg-[#E5A72F] text-[#180306] p-3 sm:p-3.5 rounded-md shadow-paper rotate-12 w-44 sm:w-56 cursor-pointer select-none">
            <div class="flex justify-between items-center text-[8px] sm:text-[9px] font-mono tracking-widest border-b border-[#180306]/30 pb-1 mb-1 font-bold">
              <span id="heroTicketLot">LOT #01975</span>
              <span>PURE DESI</span>
            </div>
            <span class="font-serif text-xs sm:text-sm font-black tracking-tight block">
              The Lyallpur Store
            </span>
            <span class="text-[8px] sm:text-[9px] font-sans tracking-wider text-[#180306]/80 mt-0.5 block">
              100% PURE COW DESI GHEE
            </span>
          </div>
        </div>

        <!-- Main Poster Composition -->
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto z-20 pt-2 pb-6">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Headline Stack (Left/Center) -->
            <div class="lg:col-span-7 xl:col-span-8 relative min-h-[360px] sm:min-h-[440px] flex items-center">
              
              <!-- Orange Scalloped Seal (Video Match) -->
              <div class="absolute -top-10 sm:-top-16 -left-2 sm:-left-8 z-30 transition-transform duration-300 hover:rotate-0 hover:scale-110">
                <div id="heroSealBadge" class="scalloped-badge bg-[#E4702A] text-white w-28 h-28 sm:w-36 sm:h-36 -rotate-12 shadow-paper flex flex-col items-center justify-center p-2 text-center cursor-pointer transition-all duration-300">
                  <span id="heroSealTop" class="text-[9px] sm:text-xs font-mono font-extrabold tracking-wider">100% PURE</span>
                  <span id="heroSealMid" class="font-serif text-sm sm:text-lg font-black leading-tight">DESI GHEE</span>
                  <span id="heroSealBot" class="text-[8px] sm:text-[9px] tracking-widest text-white/90">SINCE 1975</span>
                </div>
              </div>

              <!-- Title Slide 1: SINCE 1975 -->
              <div id="heroTitleSlide1" class="relative pt-6 sm:pt-8 pl-4 sm:pl-10 transition-all duration-500 opacity-100 transform translate-y-0 w-full">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-6 h-[2px] bg-[#E5A72F]"></span>
                  <span class="text-[#E5A72F] text-xs font-bold tracking-[0.2em] uppercase font-mono">HERITAGE SINCE 1975 · 01 / 03</span>
                </div>
                <h1 class="font-serif text-[clamp(4.2rem,11.5vw,11rem)] font-extrabold text-[#F7F1E7] tracking-tight leading-[0.85] drop-shadow-[0_4px_24px_rgba(0,0,0,0.7)]">
                  SINCE
                </h1>
                <h2 class="font-serif text-[clamp(4.8rem,13vw,13rem)] font-black text-[#F7F1E7] tracking-tight leading-[0.82] pl-6 sm:pl-14 drop-shadow-[0_4px_24px_rgba(0,0,0,0.7)]">
                  1975
                </h2>
                <p class="font-serif italic text-lg sm:text-2xl text-[#F7F1E7]/85 mt-4 sm:mt-6 max-w-xl pl-2">
                  "A sweet story, still being written."
                </p>
                <div class="flex flex-wrap items-center gap-4 mt-6 sm:mt-8 pl-2">
                  <a href="#online-store-section" class="px-8 py-3.5 rounded-full bg-[#F7F1E7] text-[#180306] font-serif font-bold text-sm tracking-wider uppercase hover:bg-[#E5A72F] transition-all shadow-paper active:translate-y-0.5 cursor-pointer inline-flex items-center gap-2 group">
                    <span>SHOP SWEETS</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                  <a href="#heritage-section" class="px-7 py-3.5 rounded-full border border-[#F7F1E7]/40 text-[#F7F1E7] font-serif text-sm tracking-wider uppercase hover:bg-white/10 transition-all cursor-pointer">
                    <span>A SWEET STORY ↗</span>
                  </a>
                </div>
              </div>

              <!-- Title Slide 2: PURE DESI GHEE -->
              <div id="heroTitleSlide2" class="absolute inset-0 pt-6 sm:pt-8 pl-4 sm:pl-10 transition-all duration-500 opacity-0 pointer-events-none transform translate-y-8 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-6 h-[2px] bg-[#E5A72F]"></span>
                  <span class="text-[#E5A72F] text-xs font-bold tracking-[0.2em] uppercase font-mono">AUTHENTIC MITHAI · 02 / 03</span>
                </div>
                <h2 class="font-serif text-[clamp(4.2rem,11.5vw,11rem)] font-extrabold text-[#F7F1E7] tracking-tight leading-[0.85] drop-shadow-[0_4px_24px_rgba(0,0,0,0.7)]">
                  PURE
                </h2>
                <h2 class="font-serif text-[clamp(4.8rem,13vw,13rem)] font-black text-[#F7F1E7] tracking-tight leading-[0.82] pl-6 sm:pl-14 drop-shadow-[0_4px_24px_rgba(0,0,0,0.7)]">
                  DESI GHEE
                </h2>
                <p class="font-serif italic text-lg sm:text-2xl text-[#F7F1E7]/85 mt-4 sm:mt-6 max-w-xl pl-2">
                  Slow-roasted chana, khoya and pure golden bilona cow ghee.
                </p>
                <div class="flex flex-wrap items-center gap-4 mt-6 sm:mt-8 pl-2">
                  <a href="#online-store-section" class="px-8 py-3.5 rounded-full bg-[#F7F1E7] text-[#180306] font-serif font-bold text-sm tracking-wider uppercase hover:bg-[#E5A72F] transition-all shadow-paper active:translate-y-0.5 cursor-pointer inline-flex items-center gap-2 group">
                    <span>ORDER SWEETS</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </a>
                  <a href="#heritage-section" class="px-7 py-3.5 rounded-full border border-[#F7F1E7]/40 text-[#F7F1E7] font-serif text-sm tracking-wider uppercase hover:bg-white/10 transition-all cursor-pointer">
                    <span>OUR CRAFT ↗</span>
                  </a>
                </div>
              </div>

              <!-- Title Slide 3: MADE FOR CELEBRATIONS -->
              <div id="heroTitleSlide3" class="absolute inset-0 pt-6 sm:pt-8 pl-4 sm:pl-10 transition-all duration-500 opacity-0 pointer-events-none transform translate-y-8 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-6 h-[2px] bg-[#E5A72F]"></span>
                  <span class="text-[#E5A72F] text-xs font-bold tracking-[0.2em] uppercase font-mono">ROYAL GIFTING · 03 / 03</span>
                </div>
                <h2 class="font-serif text-[clamp(3.8rem,10.5vw,9.5rem)] font-extrabold text-[#F7F1E7] tracking-tight leading-[0.85] drop-shadow-[0_4px_24px_rgba(0,0,0,0.7)]">
