            <input type="email" placeholder="Email address" class="w-full px-3 py-2 bg-white/10 border border-[#F7F1E7]/30 text-xs rounded-l-lg text-white" />
            <button class="px-3 bg-[#E5A72F] text-[#180306] rounded-r-lg font-bold">→</button>
          </div>
        </div>
      </div>

      <div class="pt-8 border-t border-[#F7F1E7]/15 flex justify-between text-xs font-mono text-[#F7F1E7]/60">
        <div>© 2026 The Lyallpur Store. FSSAI Lic. No. 12117801000234.</div>
        <div>All sweets prepared in 100% pure desi ghee.</div>
      </div>
    </div>
  </footer>

  <!-- ================= FLOATING SUPPORT CHAT BUTTON ================= -->
  <a href="https://wa.me/919814000000?text=Namaste%20Lyallpur%20Sweets,%20I%20would%20like%20to%20enquire%20about%20ordering%20sweets." target="_blank" class="fixed bottom-6 right-6 z-40 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#180306] text-[#E5A72F] border-2 border-[#E5A72F] shadow-paper flex items-center justify-center cursor-pointer hover:scale-110 transition-transform">
    <i data-lucide="message-circle" class="w-6 h-6"></i>
    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#E5A72F] opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-[#E4702A] border border-[#180306]"></span>
    </span>
  </a>

  <!-- ================= CART DRAWER (SLIDE-OUT FROM RIGHT) ================= -->
  <div id="cartDrawerBackdrop" onclick="toggleCart()" class="fixed inset-0 bg-[#180306]/75 backdrop-blur-xs z-50 hidden opacity-0 transition-opacity duration-300"></div>
  
  <div id="cartDrawer" class="fixed top-0 right-0 bottom-0 w-full max-w-[480px] bg-[#F7F1E7] paper-cream text-[#180306] shadow-2xl z-50 transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] flex flex-col justify-between border-l-2 border-[#180306]">
    <div class="p-5 sm:p-6 border-b border-[#180306]/15 flex items-center justify-between bg-[#EFE4D0]/60">
      <div>
        <h2 class="font-serif text-xl sm:text-2xl font-black text-[#180306]">Your Sweet Box</h2>
        <span id="cartDrawerSubtitle" class="text-[10px] font-mono uppercase tracking-wider text-[#180306]/60">0 Confections Selected</span>
      </div>
      <button onclick="toggleCart()" class="w-8 h-8 rounded-full bg-[#180306] text-[#F7F1E7] flex items-center justify-center hover:bg-[#E5A72F] hover:text-[#180306] transition-colors">
        ✕
      </button>
    </div>

    <!-- Items list -->
    <div id="cartItemsList" class="flex-1 overflow-y-auto p-5 sm:p-6 divide-y divide-[#180306]/10">
      <!-- Rendered dynamically -->
    </div>

    <!-- Drawer Footer -->
    <div class="p-5 sm:p-6 border-t-2 border-[#180306] bg-[#EFE4D0]/60 space-y-4">
      <div class="flex justify-between font-serif font-black text-lg">
        <span>Grand Total:</span>
        <span id="cartDrawerTotal">₹0</span>
      </div>
      <div class="space-y-2">
        <button onclick="openCheckout()" class="w-full py-3.5 rounded-full bg-[#180306] text-[#F7F1E7] font-serif font-bold text-sm tracking-widest uppercase hover:bg-[#E5A72F] hover:text-[#180306] transition-all shadow-paper">
          CHECKOUT →
        </button>
        <button onclick="orderViaWhatsApp()" class="w-full py-3 rounded-full bg-[#1FA855] text-white font-serif font-bold text-xs uppercase tracking-wider hover:bg-[#188c45] transition-all">
          ORDER ON WHATSAPP
        </button>
      </div>
    </div>
  </div>

  <!-- ================= CART REASSURANCE MODAL ================= -->
  <div id="reassuranceModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 select-none hidden">
    <div onclick="closeReassurance()" class="fixed inset-0 bg-[#180306]/75 backdrop-blur-xs"></div>
    <div class="relative w-full max-w-md bg-[#F7F1E7] paper-cream rounded-3xl border-2 border-[#180306] shadow-paper-lg p-8 text-center z-10 text-[#180306]">
      <button onclick="closeReassurance()" class="absolute top-4 right-4 p-2 text-[#180306]/60 hover:text-[#180306]">✕</button>
      <div class="w-20 h-20 rounded-2xl bg-[#180306] text-[#E5A72F] flex items-center justify-center shadow-paper mx-auto mb-4 border-2 border-[#E5A72F]">
        <span class="font-serif text-3xl font-black">1975</span>
      </div>
      <h3 class="font-serif text-2xl font-black text-[#180306] mb-2 leading-tight">
        Sweet Blessings for a Brighter Tomorrow
      </h3>
      <p class="font-sans text-xs text-[#180306]/80 mb-6 leading-relaxed">
        Your delicacy has been added to your Sweet Box. Handcrafted with 100% pure desi ghee and packaged fresh in Ludhiana.
      </p>
      <button onclick="closeReassurance(); toggleCart();" class="w-full py-3.5 rounded-full bg-[#180306] text-[#F7F1E7] font-serif font-bold text-xs uppercase tracking-wider shadow-paper hover:bg-[#E5A72F] hover:text-[#180306]">
        VIEW SWEET BOX & CHECKOUT →
      </button>
    </div>
  </div>

  <!-- ================= JAVASCRIPT LOGIC ================= -->
  <script>
    // Product Catalogue Data
    const PRODUCTS = [
      {
        id: 'chana-barfi',
        name: 'Chana Barfi',
        punjabi: 'ਚਨਾ ਬਰਫ਼ੀ',
        category: 'sweets',
        price: 360,
        weight: '400g',
        image: 'assets/images/lyallpur_dhoda_barfi_1789498301424.jpg',
        badge: 'Bestseller',
        ghee: true,
      },
      {
        id: 'desi-ghee-motichoor-laddu',
        name: 'Desi Ghee Motichoor Laddu',
        punjabi: 'ਮੋਤੀਚੂਰ ਲੱਡੂ',
        category: 'sweets',
        price: 340,
        weight: '500g',
        image: 'assets/images/lyallpur_motichoor_laddu_1789498314629.jpg',
        badge: 'Most Loved',
        ghee: true,
      },
      {
        id: 'dhoda-barfi',
        name: 'Dhoda Barfi',
        punjabi: 'ਢੋਡਾ ਬਰਫ਼ੀ',
        category: 'sweets',
        price: 390,
        weight: '500g',
        image: 'assets/images/lyallpur_dhoda_barfi_1789498301424.jpg',
        badge: 'Heritage',
        ghee: true,
      },
      {
        id: 'desi-ghee-atta-panjiri',
        name: 'Desi Ghee Atta Panjiri',
        punjabi: 'ਆਟਾ ਪੰਜੀਰੀ',
        category: 'sweets',
        price: 450,
        weight: '500g',
        image: 'assets/images/lyallpur_desi_ghee_1789498186551.jpg',
        badge: 'Nutritional',
        ghee: true,
      },
      {
        id: 'roasted-kalakand',
        name: 'Roasted Kalakand',
        punjabi: 'ਰੋਸਟੇਡ ਕਲਾਕੰਦ',
        category: 'sweets',
        price: 370,
        weight: '500g',
        image: 'assets/images/lyallpur_hero_sweets_1789498173011.jpg',
        badge: 'Artisanal',
        ghee: true,
      },
      {
        id: 'kaju-barfi',
        name: 'Shahi Kaju Barfi',
        punjabi: 'ਕਾਜੂ ਬਰਫ਼ੀ',
        category: 'sweets',
        price: 490,
        weight: '400g',
        image: 'assets/images/lyallpur_hero_sweets_1789498173011.jpg',
        badge: 'Premium Gift',
        ghee: false,
      },
      {
        id: 'gur-gachak',
        name: 'Heritage Gur Peanut Gachak',
        punjabi: 'ਗੁੜ ਮੂੰਗਫਲੀ ਗੱਚਕ',
        category: 'gachak',
        price: 210,
        weight: '400g',
        image: 'assets/images/lyallpur_punjabi_gachak_1789498330845.jpg',
        badge: 'Winter Special',
        ghee: true,
      },
      {
        id: 'punjabi-mathi',
        name: 'Punjabi Spiced Mathi',
        punjabi: 'ਪੰਜਾਬੀ ਮੱਠੀ',
        category: 'namkeen',
        price: 180,
        weight: '400g',
        image: 'assets/images/lyallpur_punjabi_mathi_1789498344505.jpg',
        badge: 'Tea-time',
        ghee: true,
      },
      {
        id: 'royal-heritage-box',
        name: 'The Lyallpur Royal Heritage Gifting Box',
        punjabi: 'ਰਾਇਲ ਹੈਰੀਟੇਜ ਗਿਫ਼ਟ ਬਾਕਸ',
        category: 'gifting',
        price: 1450,
        weight: '1.2kg Grand Casket',
        image: 'assets/images/lyallpur_gifting_box_1789498201866.jpg',
        badge: 'Luxury Casket',
        ghee: true,
      }
    ];

    let cart = [];
    let hasSeenReassurance = false;
    let selectedCat = 'all';

    // Initialize Page
    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      renderProducts();
      initCurtainLoader();
      initScrollProgress();
    });

    // Curtain Loading Animation
    function initCurtainLoader() {
      let p = 0;
      const progressEl = document.getElementById('curtainProgress');
      const textEl = document.getElementById('progressText');
      const wordsEl = document.getElementById('cyclingWord');
      const words = ['MITHAI', 'PURE DESI GHEE', 'ROYAL GIFTING', 'PUNJAB', 'EST. 1975'];
      let wIdx = 0;

      const wordTimer = setInterval(() => {
        wIdx = (wIdx + 1) % words.length;
        wordsEl.innerText = `✦ ${words[wIdx]} ✦`;
      }, 400);

      const timer = setInterval(() => {
        p += 3;
        if (p >= 100) {
          p = 100;
          clearInterval(timer);
          clearInterval(wordTimer);
          setTimeout(openCurtains, 200);
        }
        progressEl.style.width = p + '%';
        textEl.innerText = p + '%';
      }, 35);
    }

    function openCurtains() {
      const left = document.getElementById('leftCurtain');
      const right = document.getElementById('rightCurtain');
      const content = document.getElementById('curtainContent');
      const curtains = document.getElementById('openingCurtains');

      content.style.opacity = '0';
      left.style.transform = 'translateX(-100%)';
      right.style.transform = 'translateX(100%)';

      setTimeout(() => {
        curtains.style.display = 'none';
      }, 1100);
    }

    function skipIntro() {
      const curtains = document.getElementById('openingCurtains');
      curtains.style.opacity = '0';
      setTimeout(() => {
        curtains.style.display = 'none';
      }, 400);
    }

    // Scroll Progress & Navbar Scrolled State
    function initScrollProgress() {
      window.addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = (window.scrollY / h) * 100;
        document.getElementById('scrollProgress').style.width = scrolled + '%';

        const nav = document.getElementById('mainNavbar');
        if (window.scrollY > 40) {
          nav.classList.add('bg-[#180306]/95', 'backdrop-blur-md', 'border-b', 'border-[#F7F1E7]/15', 'shadow-lg');
          nav.classList.remove('bg-transparent');
        } else {
          nav.classList.remove('bg-[#180306]/95', 'backdrop-blur-md', 'border-b', 'border-[#F7F1E7]/15', 'shadow-lg');
          nav.classList.add('bg-transparent');
        }
      });
    }

    // Product Grid Rendering
    function renderProducts() {
      const grid = document.getElementById('productsGrid');
      const search = (document.getElementById('storeSearchInput')?.value || '').toLowerCase();

      const filtered = PRODUCTS.filter(p => {
        if (selectedCat !== 'all' && p.category !== selectedCat) return false;
        if (search && !p.name.toLowerCase().includes(search) && !p.punjabi.toLowerCase().includes(search)) return false;
        return true;
      });

      grid.innerHTML = filtered.map(p => `
        <div class="bg-white rounded-xl border border-[#180306]/20 p-3.5 shadow-paper-sm flex flex-col justify-between group hover:-translate-y-1 transition-transform">
          <div class="relative aspect-[4/5] rounded-lg overflow-hidden bg-[#180306] mb-3">
            <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute top-2.5 left-2.5 bg-[#E5A72F] text-[#180306] text-[9px] font-mono font-bold px-2 py-0.5 rounded shadow">
              ${p.badge}
            </div>
          </div>
          <div>
            <div class="flex justify-between items-baseline mb-1">
              <h4 class="font-serif font-black text-base text-[#180306] truncate">${p.name}</h4>
              <span class="font-serif font-black text-sm text-[#180306]">₹${p.price}</span>
            </div>
            <span class="text-xs text-[#180306]/60 font-sans block mb-2">${p.punjabi}</span>
            <span class="text-[10px] font-mono text-[#180306]/60 uppercase block mb-3">Pack: ${p.weight}</span>
          </div>
          <button onclick="addToCartDirect('${p.id}', '${p.name}', '${p.weight}', ${p.price})" class="w-full py-2.5 rounded-lg bg-[#180306] text-[#F7F1E7] font-serif font-bold text-xs uppercase tracking-wider hover:bg-[#E5A72F] hover:text-[#180306] transition-colors shadow flex items-center justify-center gap-1.5 cursor-pointer">
            <span>ADD TO CART</span>
            <span>+</span>
          </button>
        </div>
      `).join('');

      lucide.createIcons();
    }

    function setStoreCategory(cat, btn) {
      selectedCat = cat;
      document.querySelectorAll('.category-btn').forEach(b => {
        b.classList.remove('bg-[#180306]', 'text-[#F7F1E7]', 'active');
        b.classList.add('bg-[#EFE4D0]', 'text-[#180306]');
      });
      btn.classList.add('bg-[#180306]', 'text-[#F7F1E7]', 'active');
      btn.classList.remove('bg-[#EFE4D0]', 'text-[#180306]');
      renderProducts();
    }

    function filterProducts() {
      renderProducts();
    }

    // Cart Management
    function addToCartDirect(id, name, weight, price) {
      const existing = cart.find(item => item.id === id && item.weight === weight);
      if (existing) {
        existing.qty += 1;
      } else {
        const prod = PRODUCTS.find(p => p.id === id);
        cart.push({
          id,
          name,
          weight,
          price,
          qty: 1,
          image: prod ? prod.image : 'assets/images/lyallpur_dhoda_barfi_1789498301424.jpg'
        });
      }

      updateCartUI();

      if (!hasSeenReassurance) {
        hasSeenReassurance = true;
        document.getElementById('reassuranceModal').classList.remove('hidden');
      } else {
        openCart();
      }
    }

    function updateCartUI() {
      const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
      const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

      document.getElementById('navCartBadge').innerText = totalCount;
      document.getElementById('cartDrawerSubtitle').innerText = `${totalCount} Confection${totalCount === 1 ? '' : 's'} Selected`;
      document.getElementById('cartDrawerTotal').innerText = `₹${subtotal}`;

      const list = document.getElementById('cartItemsList');
      if (cart.length === 0) {
        list.innerHTML = `
          <div class="text-center py-16 text-[#180306]/70">
            <span class="text-4xl block mb-2">🪔</span>
            <p class="font-serif font-bold text-base">Your sweet box is empty</p>
          </div>
        `;
      } else {
        list.innerHTML = cart.map((item, idx) => `
          <div class="py-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded object-cover border border-[#180306]/20" />
              <div>
                <h5 class="font-serif font-bold text-xs truncate max-w-[170px]">${item.name}</h5>
                <span class="text-[10px] font-mono text-[#E4702A]">${item.weight} · ₹${item.price}</span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex items-center border border-[#180306]/30 rounded text-xs">
                <button onclick="changeQty(${idx}, -1)" class="px-2 py-0.5 hover:bg-black/5 font-bold">−</button>
                <span class="px-2 font-mono font-bold">${item.qty}</span>
                <button onclick="changeQty(${idx}, 1)" class="px-2 py-0.5 hover:bg-black/5 font-bold">+</button>
              </div>
              <span class="font-serif font-black text-xs w-12 text-right">₹${item.price * item.qty}</span>
            </div>
          </div>
        `).join('');
      }
    }

    function changeQty(idx, delta) {
      cart[idx].qty += delta;
      if (cart[idx].qty <= 0) {
        cart.splice(idx, 1);
      }
      updateCartUI();
    }

    function toggleCart() {
      const drawer = document.getElementById('cartDrawer');
      const backdrop = document.getElementById('cartDrawerBackdrop');
      if (drawer.classList.contains('translate-x-full')) {
        openCart();
      } else {
        closeCart();
      }
    }

    function openCart() {
      const drawer = document.getElementById('cartDrawer');
      const backdrop = document.getElementById('cartDrawerBackdrop');
      backdrop.classList.remove('hidden');
      setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
      drawer.classList.remove('translate-x-full');
    }

    function closeCart() {
      const drawer = document.getElementById('cartDrawer');
      const backdrop = document.getElementById('cartDrawerBackdrop');
      drawer.classList.add('translate-x-full');
      backdrop.classList.add('opacity-0');
      setTimeout(() => backdrop.classList.add('hidden'), 300);
    }

    function closeReassurance() {
      document.getElementById('reassuranceModal').classList.add('hidden');
    }

    function orderViaWhatsApp() {
      if (cart.length === 0) return;
      const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      const itemsList = cart.map(i => `• ${i.name} (${i.weight}) x ${i.qty} = ₹${i.price * i.qty}`).join('%0A');
      const msg = `*NEW ORDER - THE LYALLPUR STORE*%0A%0A${itemsList}%0A%0A*Total Amount:* ₹${subtotal}%0APlease share delivery details and dispatch confirmation. Thank you!`;
      window.open(`https://wa.me/919814000000?text=${msg}`, '_blank');
    }

    function openCheckout() {
      orderViaWhatsApp();
    }

    // ================= HERO SCROLL CANVAS SEQUENCE =================
    let jumpToHeroChapter = function(idx) {};

    (function initHeroCanvas() {
      const track = document.getElementById('hero-track');
      const canvas = document.getElementById('heroFrameCanvas');
      if (!track || !canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const totalFrames = 240;
      const frames = new Array(totalFrames).fill(null);
      let targetProgress = 0;
      let currentProgress = 0;
      const lerp = 0.12;

      // DOM Elements for dynamic sync
      const slide1 = document.getElementById('heroTitleSlide1');
      const slide2 = document.getElementById('heroTitleSlide2');
      const slide3 = document.getElementById('heroTitleSlide3');
      const sealTop = document.getElementById('heroSealTop');
      const sealMid = document.getElementById('heroSealMid');
      const sealBot = document.getElementById('heroSealBot');
      const chapterNum = document.getElementById('heroChapterNum');
      const seg1 = document.getElementById('heroSeg1');
      const seg2 = document.getElementById('heroSeg2');
      const seg3 = document.getElementById('heroSeg3');
      const handoffVeil = document.getElementById('heroHandoffVeil');
      const scrollHint = document.getElementById('scrollHint');

      function resizeCanvas() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = canvas.parentElement.offsetWidth * dpr;
        canvas.height = canvas.parentElement.offsetHeight * dpr;
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      // Jump to chapter helper
      jumpToHeroChapter = function(idx) {
        const maxScroll = track.offsetHeight - window.innerHeight;
        const targetP = idx === 0 ? 0.05 : idx === 1 ? 0.40 : 0.75;
        const targetScroll = track.offsetTop + targetP * maxScroll;
        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      };

      // Progressive frame loading
      function loadFrame(idx) {
        if (frames[idx]) return Promise.resolve(frames[idx]);
        const pad = String(idx + 1).padStart(3, '0');
        const url = `hero-frames/frame_${pad}.webp`;
        return new Promise((resolve) => {
          const img = new Image();
          img.src = url;
          img.onload = () => {
            frames[idx] = img;
            resolve(img);
          };
          img.onerror = () => resolve(null);
        });
      }

      // Initial poster frame
      loadFrame(0).then(img => {
        if (img) drawCover(img);
      });

      // Background progressive preloading passes
      async function preloadAll() {
        for (let i = 0; i < totalFrames; i += 15) {
          await loadFrame(i);
        }
        for (let i = 0; i < totalFrames; i += 5) {
          await loadFrame(i);
        }
        for (let i = 0; i < totalFrames; i++) {
          if (!frames[i]) await loadFrame(i);
        }
      }
      preloadAll();

      function getNearest(idx) {
        if (frames[idx]) return frames[idx];
        for (let offset = 1; offset < totalFrames; offset++) {
          if (idx - offset >= 0 && frames[idx - offset]) return frames[idx - offset];
          if (idx + offset < totalFrames && frames[idx + offset]) return frames[idx + offset];
        }
        return null;
      }

      function drawCover(img) {
        if (!img || !canvas.width || !canvas.height) return;
        const imgAspect = (img.width || 1920) / (img.height || 1080);
        const canvasAspect = canvas.width / canvas.height;
        let w, h, x, y;
        if (canvasAspect > imgAspect) {
          w = canvas.width;
          h = canvas.width / imgAspect;
          x = 0;
          y = (canvas.height - h) * 0.5;
        } else {
          h = canvas.height;
          w = canvas.height * imgAspect;
          x = (canvas.width - w) * 0.5;
          y = 0;
        }
        ctx.drawImage(img, x, y, w, h);
      }

      function onScroll() {
        const maxScroll = track.offsetHeight - window.innerHeight;
        if (maxScroll <= 0) return;
        const scrollDist = -track.getBoundingClientRect().top;
        targetProgress = Math.max(0, Math.min(1, scrollDist / maxScroll));
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      function render() {
        currentProgress += (targetProgress - currentProgress) * lerp;
        const p = Math.max(0, Math.min(1, currentProgress));

        // 1. Draw canvas frame
        const frameIdx = Math.floor(p * (totalFrames - 1));
        const img = getNearest(frameIdx);
        if (img) drawCover(img);

        // 2. Hide scroll hint once user started scrolling
        if (scrollHint) {
          scrollHint.style.opacity = p > 0.04 ? '0' : '0.8';
        }

        // 3. Sync Titles & Seals across progress ranges
        if (p < 0.33) {
          // Chapter 1: SINCE 1975
          if (slide1) { slide1.style.opacity = '1'; slide1.style.transform = 'translateY(0)'; slide1.style.pointerEvents = 'auto'; }
          if (slide2) { slide2.style.opacity = '0'; slide2.style.transform = 'translateY(24px)'; slide2.style.pointerEvents = 'none'; }
          if (slide3) { slide3.style.opacity = '0'; slide3.style.transform = 'translateY(24px)'; slide3.style.pointerEvents = 'none'; }
          if (sealTop) sealTop.textContent = '100% PURE';
          if (sealMid) sealMid.textContent = 'DESI GHEE';
          if (sealBot) sealBot.textContent = 'SINCE 1975';
          if (chapterNum) chapterNum.textContent = '01';

          if (seg1) seg1.style.width = `${Math.min(100, (p / 0.33) * 100)}%`;
          if (seg2) seg2.style.width = '0%';
          if (seg3) seg3.style.width = '0%';
        } else if (p < 0.66) {
          // Chapter 2: PURE DESI GHEE
          if (slide1) { slide1.style.opacity = '0'; slide1.style.transform = 'translateY(-24px)'; slide1.style.pointerEvents = 'none'; }
          if (slide2) { slide2.style.opacity = '1'; slide2.style.transform = 'translateY(0)'; slide2.style.pointerEvents = 'auto'; }
          if (slide3) { slide3.style.opacity = '0'; slide3.style.transform = 'translateY(24px)'; slide3.style.pointerEvents = 'none'; }
          if (sealTop) sealTop.textContent = '100% PURE';
          if (sealMid) sealMid.textContent = 'COW GHEE';
          if (sealBot) sealBot.textContent = 'BILONA CHURNED';
          if (chapterNum) chapterNum.textContent = '02';

          if (seg1) seg1.style.width = '100%';
          if (seg2) seg2.style.width = `${Math.min(100, ((p - 0.33) / 0.33) * 100)}%`;
          if (seg3) seg3.style.width = '0%';
        } else if (p < 0.94) {
          // Chapter 3: MADE FOR CELEBRATIONS
          if (slide1) { slide1.style.opacity = '0'; slide1.style.pointerEvents = 'none'; }
          if (slide2) { slide2.style.opacity = '0'; slide2.style.transform = 'translateY(-24px)'; slide2.style.pointerEvents = 'none'; }
          if (slide3) { slide3.style.opacity = '1'; slide3.style.transform = 'translateY(0)'; slide3.style.pointerEvents = 'auto'; }
          if (sealTop) sealTop.textContent = 'EMBOSSED FOIL';
          if (sealMid) sealMid.textContent = 'SHAGUN READY';
          if (sealBot) sealBot.textContent = 'ROYAL GIFT';
          if (chapterNum) chapterNum.textContent = '03';

          if (seg1) seg1.style.width = '100%';
          if (seg2) seg2.style.width = '100%';
          if (seg3) seg3.style.width = `${Math.min(100, ((p - 0.66) / 0.28) * 100)}%`;
        } else {
          // Handoff to Marquee (p >= 0.94)
          if (slide3) { slide3.style.opacity = '0'; slide3.style.transform = 'translateY(-24px)'; }
          if (seg1) seg1.style.width = '100%';
          if (seg2) seg2.style.width = '100%';
          if (seg3) seg3.style.width = '100%';
        }

        // Handoff veil opacity fade
        if (handoffVeil) {
          if (p >= 0.93) {
            handoffVeil.style.opacity = String((p - 0.93) / 0.07);
          } else {
            handoffVeil.style.opacity = '0';
          }
        }

        requestAnimationFrame(render);
      }
      render();
    })();
  </script>
</body>
</html>
